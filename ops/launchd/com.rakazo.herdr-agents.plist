<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/luke/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.rakazo.herdr-agents</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/luke/.local/bin/herdr</string>
		<string>--session</string>
		<string>agents</string>
		<string>server</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/luke/dev/rakazo-setup/.logs/herdr-agents.log</string>
	<key>StandardOutPath</key>
	<string>/Users/luke/dev/rakazo-setup/.logs/herdr-agents.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
